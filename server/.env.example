# Copie para .env e ajuste. O .env real NUNCA vai para o Git.
#   cp .env.example .env && nano .env
#
# Uma variavel passada na linha de comando tem prioridade sobre o .env:
#   PAN_SIGN=1 python server.py   ->  testa sem editar arquivo

# --- Login (usuarios/sessoes -- ver README secao 5.1a) ----------------------
DATABASE_URL=postgresql://oiticica:TROQUE_ESTA_SENHA@127.0.0.1:5432/oiticica
# SESSION_COOKIE_SECURE=false   # true so atras de HTTPS de verdade (reverse proxy)
# SESSAO_DURACAO_H=168          # 7 dias

# --- Onde esta o Raspberry --------------------------------------------------
# CONTROLLER_URL       = servidor -> Pi (proxy PTZ, empurrao do estado)
# CONTROLLER_PUBLIC_URL = navegador -> Pi (PTZ direto, sem passar pelo server)
CONTROLLER_URL=http://172.16.1.2:8090
CONTROLLER_PUBLIC_URL=http://172.16.1.2:8090

# --- Geometria da camera ----------------------------------------------------
# PAN_SIGN=-1              # inverta se o cone andar espelhado
# TILT_SIGN=1
# CAMERA_ABS_ALT=88.5      # elevacao absoluta da lente, quando for medida

# --- Cone de visao ----------------------------------------------------------
# CONE_HALF_ANGLE_WIDE=18
# CONE_HALF_ANGLE_TELE=2
# CONE_RING_RAYS=24

# --- Ciclo de vida dos alertas ----------------------------------------------
# DEDUP_RAIO_M=1.5
# DEDUP_ANG_DEG=1.5
# REARME_SEGUNDOS=600

# --- Modo borda ------------------------------------------------------------
# STREAM_JANELA_S=60       # quanto dura o pedido de video antes de expirar
# STREAM_FPS=4
# STREAM_LARGURA=640
# STREAM_QUALIDADE=60
DEVICE_ID=oiticica-cam-01

# --- Ponte MQTT (so para testar o modo MQTT com um mosquitto) ---------------
# MQTT_BRIDGE=false
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
