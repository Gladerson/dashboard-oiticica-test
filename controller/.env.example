# Copie este arquivo para .env e preencha com os valores reais:
#   cp .env.example .env
#
# O .env NUNCA deve ser commitado (já está no .gitignore).

CAMERA_IP=192.168.0.90
ONVIF_PORT=80
ONVIF_USER=admin
ONVIF_PASSWORD=troque_pela_senha_real

RTSP_URL=rtsp://usuario:senha@192.168.0.90:554/cam/realmonitor?channel=1&subtype=1

SERVER_URL=http://127.0.0.1:8001

