# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env && nano .env

DEVICE_ID=oiticica-cam-01

# --- Camera ---
CAMERA_IP=192.168.0.90
ONVIF_PORT=80
ONVIF_USER=admin
ONVIF_PASSWORD=troque_pela_senha_real
RTSP_URL=rtsp://usuario:senha@192.168.0.90:554/cam/realmonitor?channel=1&subtype=1

# --- Servidor (modo HTTP, testes) ---
SERVER_URL=http://192.168.0.177:8001

# --- Broker MQTT (modo MQTT / ThingsBoard) ---
# O token mora AQUI, nunca desce do servidor pela rede.
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOKEN=
MQTT_TLS=false
# MQTT_TOPICO_FRAME=oiticica/oiticica-cam-01/frame
# MQTT_FALLBACK_SEGUNDOS=30

TRANSPORTE_INICIAL=http

# --- Modelo hibrido ---
# HEF_PATH=best_backbone.hef
# HEAD_ONNX_PATH=best_head.onnx
# CLASS_NAMES=rachadura
# MAPA_HEF_PARA_ONNX={"yolo26_fissuras_backbone/conv39":"/model.10/cv2/act/Mul_output_0", ...}

# --- Inferencia (limiar do modelo INT8, NAO o do .pt) ---
CONF_THRESHOLD=0.15
IOU_THRESHOLD=0.45
INFERIR_A_CADA_N_FRAMES=5
COOLDOWN_DETECCAO_S=5

# --- Evidencia local (a deteccao em si so manda coordenadas) ---
# EVIDENCIA_JPEG_Q=85
# EVIDENCIAS_MAX_MB=2048

# --- Stream sob demanda ---
# STREAM_FPS=4
# STREAM_LARGURA=640
# STREAM_JPEG_Q=60
# STREAM_TTL_S=75

# --- PTZ (medidos com o calibrar_curso.py) ---
# PAN_DEG_RANGE=180.0
# TILT_DEG_RANGE=90.0
